# Run ResearcherAnalysisService with its http (Development) launch profile.
# Start Ollama and run: ollama pull qwen3:1.7b
# In Visual Studio, set the HTTP client timeout to at least 300 seconds for local inference.
# Run individual requests using "Send Request"; the last requests intentionally return 400.
# These are synthetic fixtures. They do not fetch or modify researcher records.
# These direct AI tests require a snapshot. For ID-only generate/save and retrieve requests,
# use AnalyzeResearcher and GetResearcherAnalysis in AcademicPerformance.http.
# For real collector data, use the database-ID requests in AcademicPerformance.http.
# If Service:ApiKey is configured, supply X-Analysis-Key using your HTTP client's private settings.
# A service access key is separate from a paid AI key; local Development needs neither.
# Never commit real credentials or researcher input to this file.

@analysisHost = http://localhost:5011
@syntheticResearcherId = 42
@snapshotAt = 2026-01-01T00:00:00Z

### Health: no SQL Server or model required
GET {{analysisHost}}/health
Accept: application/json

### English report: partial sample with abstracts and separate provider metrics
# Expected: 200; activity count 2, coverage total 3, isPartial true, publicationsWithAbstract 1.
# Exact model wording varies; every observation must cite a supplied field and verbatim quote.
POST {{analysisHost}}/api/v1/analyze
Content-Type: application/json
Accept: application/json

{
  "researcherId": {{syntheticResearcherId}},
  "researcherName": "Synthetic Researcher",
  "department": "Environmental Engineering",
  "snapshotAt": "{{snapshotAt}}",
  "language": "en",
  "totalPublicationCount": 3,
  "publications": [
    {
      "id": "publication-101",
      "title": "Coastal water monitoring",
      "year": 2024,
      "category": "Article",
      "abstract": "We compare two monitoring methods. Further validation is needed.",
      "keywords": "water quality; coastal monitoring",
      "sources": "ORCID"
    },
    {
      "id": "publication-102",
      "title": "Monitoring water quality",
      "year": 2025,
      "category": "Article",
      "abstract": null,
      "keywords": null,
      "sources": "WebOfScience"
    }
  ],
  "citationMetrics": [
    {
      "provider": "GoogleScholar",
      "citationCount": 12,
      "hIndex": 2,
      "collectedAt": "{{snapshotAt}}"
    },
    {
      "provider": "WebOfScience",
      "citationCount": null,
      "hIndex": null,
      "collectedAt": "{{snapshotAt}}"
    }
  ]
}

