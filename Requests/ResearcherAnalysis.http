# Collector (5001), ResearcherAnalysisService (5011), SQL Server ve Ollama calisir durumda olmali.
# PersonelID: akademisyenin personel kaydindaki metin kimligi. Bastaki sifirlar korunur.
# snapshotAt: rapora yazilan veri tarihi; gecmise yonelik kayit secmez.

@host = http://localhost:5001
@personelId = 000000987654
@snapshotAt = 2026-09-08T00:00:00Z

### Analiz olustur ve kaydet
POST {{host}}/Services/AcademicPerformance/V1/AnalyzeResearcher
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "snapshotAt": "{{snapshotAt}}"
}

### Son kayitli raporu getir
POST {{host}}/Services/AcademicPerformance/V1/GetResearcherAnalysis
Content-Type: application/json

{
  "PersonelID": "{{personelId}}"
}
