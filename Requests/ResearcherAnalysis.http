### Titles only: missing abstracts and unknown publication year
# Expected: 200; writingObservations [], publicationsWithAbstract 0, publicationsWithoutYear 1.
# Research themes may be empty when the model considers the title insufficient evidence.
POST {{analysisHost}}/api/v1/analyze
Content-Type: application/json
Accept: application/json

{
  "researcherId": {{syntheticResearcherId}},
  "researcherName": "Synthetic Researcher",
  "snapshotAt": "{{snapshotAt}}",
  "language": "en",
  "totalPublicationCount": 1,
  "publications": [
    {
      "id": "publication-301",
      "title": "Coastal water monitoring methods",
      "year": null,
      "category": "Unknown",
      "abstract": null,
      "keywords": null,
      "sources": "ORCID"
    }
  ],
  "citationMetrics": []
}

### Validation: empty publication list (no model call)
# Expected: 400 ValidationProblemDetails with a Publications error.
POST {{analysisHost}}/api/v1/analyze
Content-Type: application/json
Accept: application/json

{
  "researcherId": {{syntheticResearcherId}},
  "researcherName": "Synthetic Researcher",
  "snapshotAt": "{{snapshotAt}}",
  "totalPublicationCount": 0,
  "publications": [],
  "citationMetrics": []
}

### Validation: duplicate publication IDs (no model call)
# Expected: 400; IDs must be unique within the submitted snapshot.
POST {{analysisHost}}/api/v1/analyze
Content-Type: application/json
Accept: application/json

{
  "researcherId": {{syntheticResearcherId}},
  "researcherName": "Synthetic Researcher",
  "snapshotAt": "{{snapshotAt}}",
  "totalPublicationCount": 2,
  "publications": [
    { "id": "duplicate", "title": "Coastal water monitoring", "sources": "ORCID" },
    { "id": "duplicate", "title": "Monitoring water quality", "sources": "WebOfScience" }
  ],
  "citationMetrics": []
}

# Troubleshooting valid analysis requests:
# 401: Supply the service access key if Service:ApiKey is configured.
# 422: Use fewer/shorter abstracts for the configured Ollama context.
# 502: Read reason and detail in the response body; type is only the HTTP error documentation link.
# ProviderRequestFailed: providerStatus is Ollama's HTTP status (null if unavailable); check its logs.
# Other reasons describe incomplete/malformed model output or failed evidence validation.
# 503: Start Ollama, download the configured model, or check service configuration.
# 504: Local inference timed out; try a smaller sample.
# A 200 /health response only confirms the HTTP service is running, not that the model is ready.

### Ollama direct test: bypass the analysis service to see Ollama's own response
# Requires Ollama running locally with qwen3:1.7b installed. No analysis service or SQL Server needed.
# Send this request to investigate provider HTTP 400 errors; inspect the response body for "error".
POST http://localhost:11434/api/chat
Content-Type: application/json

{
  "model": "qwen3:1.7b",
  "stream": false,
  "think": false,
  "format": "json",
  "messages": [
    { "role": "user", "content": "Return JSON: {\"ok\":true}" }
  ]
}
