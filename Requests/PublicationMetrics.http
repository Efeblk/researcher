@collector = http://localhost:5001
@personelId = P-1001

### Read the last persisted publication-metrics-v4 snapshot and refresh status
# 202 with Data=null means the first snapshot is pending. This read action never computes or schedules.
# Data.ContextualMetrics contains own collected OpenAlex context and provider-normalized availability;
# InternalNormalizedScore stays null until an evaluated reference population exists.
POST {{collector}}/Services/AcademicPerformance/V1/GetResearcherPublicationMetrics
Content-Type: application/json

{
  "PersonelID": "{{personelId}}"
}

### Explicitly schedule a new revision; computation remains asynchronous
# Returns 202. Existing Data may be returned with Status=Stale until the worker commits.
POST {{collector}}/Services/AcademicPerformance/V1/RefreshResearcherPublicationMetrics
Content-Type: application/json

{
  "PersonelID": "{{personelId}}"
}
