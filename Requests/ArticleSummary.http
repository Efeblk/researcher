@collector = http://localhost:5001
@personelId = P-1001
@academicWorkId = 1
@canonicalWorkId = 1

### Generate and save a Turkish summary from the work's saved source URL (or abstract fallback)
POST {{collector}}/Services/AcademicPerformance/V1/SummarizeArticle
Content-Type: application/json

{"personelID":"{{personelId}}","academicWorkId":{{academicWorkId}},"language":"tr"}

### Read automatic queue status; requires a current researcher/work association
POST {{collector}}/Services/AcademicPerformance/V1/GetArticleSummaryAutomationStatus
Content-Type: application/json

{"personelID":"{{personelId}}","canonicalWorkId":{{canonicalWorkId}},"language":"tr"}

### Read the latest normalized canonical evidence for this researcher and language; no AI call
POST {{collector}}/Services/AcademicPerformance/V1/GetCanonicalArticleEvidence
Content-Type: application/json

{"personelID":"{{personelId}}","canonicalWorkId":{{canonicalWorkId}},"language":"tr","skip":0,"take":100}

### Retrieve the latest saved summary; the model service may be stopped
POST {{collector}}/Services/AcademicPerformance/V1/GetArticleSummary
Content-Type: application/json

{"personelID":"{{personelId}}","academicWorkId":{{academicWorkId}},"language":"tr"}
