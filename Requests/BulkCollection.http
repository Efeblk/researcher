# Synthetic examples. WorkerEnabled is false by default.
# Generate a new BatchId for each new batch; reuse it only for identical input.
@bulk = http://localhost:5001/Services/AcademicPerformance/V1/Bulk
@batchId = a3700086-8ad7-4871-becf-0fbd2ce586e3

### Save a batch of researcher identifiers
POST {{bulk}}/Submit
Content-Type: application/json

{
  "BatchId": "{{batchId}}",
  "Researchers": [
    {
      "PersonelID": "employee-001",
      "ResearcherID": "A-1234-2020"
    },
    {
      "PersonelID": "employee-002",
      "ORCID": "(https://orcid.org/0000-0002-1825-009X) ,",
      "ScholarID": "https://scholar.google.com.tr/citations?user=AbCdEfGhIjKl&hl=tr&utm_source=synthetic",
      "ResearcherID": "invalid optional value",
      "ScopusID": "unsupported-source-id"
    }
  ]
}

# The second row is queued with canonical ORCID and Scholar IDs. Its
# Status response entry reports Jobs[].Warnings without echoing raw values. The
# durable job keeps the original row separately; Scopus is retained but not collected.

### Read aggregate progress and the first page of results
POST {{bulk}}/Status
Content-Type: application/json

{
  "BatchId": "{{batchId}}",
  "Skip": 0,
  "Take": 100
}

### Import the configured SQL query. The committed column profile maps
# PersonelID, ORCID, ResearcherID (Web of Science), and ScholarID.
POST {{bulk}}/ImportSql
Content-Type: application/json

{
  "BatchId": "c70427c5-063e-4107-a100-f50b05f423bd"
}

### Read SQL-import batch status (use the same SQL BatchId)
POST {{bulk}}/Status
Content-Type: application/json

{
  "BatchId": "c70427c5-063e-4107-a100-f50b05f423bd",
  "Skip": 0,
  "Take": 100
}
