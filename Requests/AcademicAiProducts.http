@baseUrl = http://localhost:5001
@personelId = SYNTHETIC-PERSONEL-ID
@canonicalWorkId = 101
@manifestVersion = synthetic-reference-v1
@dossierId = 1
@runId = 22222222-2222-2222-2222-222222222222
@clientRequestId = 11111111-1111-1111-1111-111111111111

# These endpoints require the deployment's authenticated BYS access adapter.
# Anonymous requests receive HTTP 401; authenticated requests receive HTTP 503 while the
# standalone fail-closed adapter remains unconfigured. This file defines no authorization bypass.

### Search saved academic evidence
POST {{baseUrl}}/Services/AcademicPerformance/V1/SearchAcademicEvidence
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "query": "reported sampling method",
  "canonicalWorkIds": [{{canonicalWorkId}}],
  "take": 10
}

### Import a mechanically valid reference-population manifest
# approvedForInternalNormalization=false keeps scientific acceptance explicitly pending.
POST {{baseUrl}}/Services/AcademicPerformance/V1/ImportReferencePopulation
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "manifestVersion": "{{manifestVersion}}",
  "cohortDefinition": "Synthetic example cohort; replace through an approved review process.",
  "eligibilityPolicyVersion": "synthetic-eligibility-v1",
  "provenance": "Synthetic request example; no production source implied.",
  "samplingAndCoverage": "One synthetic member for contract illustration only.",
  "review": {
    "reviewer": "synthetic-reviewer",
    "reviewedAt": "2026-09-12T00:00:00Z",
    "method": "Contract review only; scientific validity was not assessed.",
    "approvedForInternalNormalization": false
  },
  "members": [
    {
      "stableMemberId": "synthetic-member-1",
      "classificationId": "synthetic-field-1",
      "publicationYear": 2025,
      "workType": "article",
      "category": "Article",
      "citationCount": 0
    }
  ]
}

### Read a saved reference-population manifest
POST {{baseUrl}}/Services/AcademicPerformance/V1/GetReferencePopulation
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "manifestVersion": "{{manifestVersion}}"
}

### Export a reproducible graph projection for a bounded 20-work pilot
POST {{baseUrl}}/Services/AcademicPerformance/V1/ExportAcademicEvidenceGraph
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "canonicalWorkIds": [101, 102, 103, 104, 105, 106, 107, 108, 109, 110,
    111, 112, 113, 114, 115, 116, 117, 118, 119, 120]
}

### Create an HR evidence dossier
POST {{baseUrl}}/Services/AcademicPerformance/V1/CreateHrEvidenceDossier
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "publicationMetricSnapshotId": null,
  "canonicalWorkIds": [{{canonicalWorkId}}],
  "language": "tr"
}

### Read an HR evidence dossier
POST {{baseUrl}}/Services/AcademicPerformance/V1/GetHrEvidenceDossier
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "dossierId": {{dossierId}}
}

### Append an idempotent procedural HR review action
POST {{baseUrl}}/Services/AcademicPerformance/V1/AppendHrDossierReviewAction
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "dossierId": {{dossierId}},
  "clientRequestId": "{{clientRequestId}}",
  "actionType": "EvidenceQuestioned",
  "evidenceReference": "work:101",
  "note": "Synthetic review note."
}

### Save a versioned private faculty context
POST {{baseUrl}}/Services/AcademicPerformance/V1/SaveFacultyAssistantContext
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "expectedVersion": 0,
  "context": {
    "language": "tr",
    "researchGoals": ["Synthetic research goal"],
    "courses": ["Synthetic course"],
    "teachingAudience": "Synthetic audience",
    "preferences": "Use concise evidence-linked answers."
  }
}

### Ask the faculty assistant (queues work and returns HTTP 202)
POST {{baseUrl}}/Services/AcademicPerformance/V1/StartFacultyAssistant
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "clientRequestId": "{{clientRequestId}}",
  "mode": "OwnPaperMethods",
  "language": "tr",
  "query": "reported sampling method",
  "canonicalWorkIds": [{{canonicalWorkId}}],
  "take": 10,
  "contextVersion": 1
}

### Read the latest private faculty context
POST {{baseUrl}}/Services/AcademicPerformance/V1/GetFacultyAssistantContext
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "version": 1
}

### Read a queued or completed faculty-assistant run
POST {{baseUrl}}/Services/AcademicPerformance/V1/GetFacultyAssistantRun
Content-Type: application/json

{
  "PersonelID": "{{personelId}}",
  "runId": "{{runId}}"
}
