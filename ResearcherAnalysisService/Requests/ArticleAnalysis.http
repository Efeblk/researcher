@baseUrl = http://localhost:5011
@analysisKey = REPLACE_WITH_SERVICE_API_KEY
@generationAttemptId = {{$guid}}
@verificationAttemptId = {{$guid}}

# Bu sentetik kaynağın metni 67 karakterdir. sourceHash, web JSON biçimindeki Pages dizisinin SHA-256 değeridir.
# sourceId, ArticleSourceCatalog algoritmasının aynı sayfa/metin/offset için ürettiği deterministik kimliktir.

### 1. Tek sayfalık kaynaktan destekli özet üret [ücretli Gemini üretimi]
POST {{baseUrl}}/api/v1/articles/summarize
Content-Type: application/json
Accept: application/json
X-Analysis-Key: {{analysisKey}}

{
  "language": "en",
  "sourceKind": "pdf",
  "sourceHash": "15675f8dd97b0587f577ccae9a3a080586d9829df718bb59e33f483ce6871fd1",
  "extractionVersion": "manual-pdf-v1",
  "pages": [
    {
      "pageNumber": 1,
      "text": "The study enrolled 40 participants and reports a mean of 4.2 units."
    }
  ],
  "totalSourcePages": 1,
  "isPartial": false,
  "scopeReason": null,
  "sourceSpans": [
    {
      "sourceId": "src-1-0-28e3865db3a44714",
      "pageNumber": 1,
      "startOffset": 0,
      "endOffset": 67,
      "text": "The study enrolled 40 participants and reports a mean of 4.2 units."
    }
  ]
}

### 2. Çalışan inceleme yapılandırmasını oku [okuma]
GET {{baseUrl}}/api/v1/articles/review/configuration
Accept: application/json
X-Analysis-Key: {{analysisKey}}

### 3. Dört uzman rolünü tek çağrıda çalıştır [ücretli Gemini üretimi]
POST {{baseUrl}}/api/v1/articles/review
Content-Type: application/json
Accept: application/json
X-Analysis-Key: {{analysisKey}}

{
  "language": "en",
  "sourceKind": "pdf",
  "sourceHash": "15675f8dd97b0587f577ccae9a3a080586d9829df718bb59e33f483ce6871fd1",
  "extractionVersion": "manual-pdf-v1",
  "policyVersion": "article-specialist-review-policy-v5",
  "pages": [{ "pageNumber": 1, "text": "The study enrolled 40 participants and reports a mean of 4.2 units." }],
  "totalSourcePages": 1,
  "isPartial": false,
  "scopeReason": null,
  "sourceSpans": [
    {
      "sourceId": "src-1-0-28e3865db3a44714",
      "pageNumber": 1,
      "startOffset": 0,
      "endOffset": 67,
      "text": "The study enrolled 40 participants and reports a mean of 4.2 units."
    }
  ]
}

### 4. Yalnız method üretim aşaması için bağlayıcı fiyat/ayar teklifi al [hesaplama; üretim yok]
# @name quoteGeneration
POST {{baseUrl}}/api/v1/articles/review/stages/quote
Content-Type: application/json
Accept: application/json
X-Analysis-Key: {{analysisKey}}

{
  "stage": "generation",
  "role": "method",
  "source": {
    "language": "en",
    "sourceKind": "pdf",
    "sourceHash": "15675f8dd97b0587f577ccae9a3a080586d9829df718bb59e33f483ce6871fd1",
    "extractionVersion": "manual-pdf-v1",
    "policyVersion": "article-specialist-review-policy-v5",
    "pages": [{ "pageNumber": 1, "text": "The study enrolled 40 participants and reports a mean of 4.2 units." }],
    "totalSourcePages": 1,
    "isPartial": false,
    "scopeReason": null,
    "sourceSpans": [{ "sourceId": "src-1-0-28e3865db3a44714", "pageNumber": 1, "startOffset": 0, "endOffset": 67, "text": "The study enrolled 40 participants and reports a mean of 4.2 units." }]
  }
}

### 5. Değişmemiş generation teklifini çalıştır [ücretli Gemini üretimi + kullanım yazması]
# 4. isteği önce çalıştırın. Gövde değişirse yeni quote alın; AttemptId her dispatch için benzersiz olmalıdır.
POST {{baseUrl}}/api/v1/articles/review/stages/generate
Content-Type: application/json
Accept: application/json
X-Analysis-Key: {{analysisKey}}

{
  "attemptId": "{{generationAttemptId}}",
  "settingsFingerprint": "{{quoteGeneration.response.body.$.settingsFingerprint}}",
  "requestFingerprint": "{{quoteGeneration.response.body.$.requestFingerprint}}",
  "maximumChargeUsd": {{quoteGeneration.response.body.$.maximumChargeUsd}},
  "role": "method",
  "source": {
    "language": "en",
    "sourceKind": "pdf",
    "sourceHash": "15675f8dd97b0587f577ccae9a3a080586d9829df718bb59e33f483ce6871fd1",
    "extractionVersion": "manual-pdf-v1",
    "policyVersion": "article-specialist-review-policy-v5",
    "pages": [{ "pageNumber": 1, "text": "The study enrolled 40 participants and reports a mean of 4.2 units." }],
    "totalSourcePages": 1,
    "isPartial": false,
    "scopeReason": null,
    "sourceSpans": [{ "sourceId": "src-1-0-28e3865db3a44714", "pageNumber": 1, "startOffset": 0, "endOffset": 67, "text": "The study enrolled 40 participants and reports a mean of 4.2 units." }]
  }
}

### 6. Sabit bir aday bulgu için doğrulama aşaması teklifi al [hesaplama; üretim yok]
# @name quoteVerification
POST {{baseUrl}}/api/v1/articles/review/stages/quote
Content-Type: application/json
Accept: application/json
X-Analysis-Key: {{analysisKey}}

{
  "stage": "verification",
  "role": "method",
  "source": {
    "language": "en",
    "sourceKind": "pdf",
    "sourceHash": "15675f8dd97b0587f577ccae9a3a080586d9829df718bb59e33f483ce6871fd1",
    "extractionVersion": "manual-pdf-v1",
    "policyVersion": "article-specialist-review-policy-v5",
    "pages": [{ "pageNumber": 1, "text": "The study enrolled 40 participants and reports a mean of 4.2 units." }],
    "totalSourcePages": 1,
    "isPartial": false,
    "scopeReason": null,
    "sourceSpans": [{ "sourceId": "src-1-0-28e3865db3a44714", "pageNumber": 1, "startOffset": 0, "endOffset": 67, "text": "The study enrolled 40 participants and reports a mean of 4.2 units." }]
  },
  "findings": [
    {
      "findingId": "method-1",
      "role": "method",
      "kind": "review_question",
      "basis": "The study enrolled 40 participants.",
      "suggestion": "Report how the sample size was chosen.",
      "sourceIds": ["src-1-0-28e3865db3a44714"]
    }
  ]
}

### 7. Değişmemiş verification teklifini çalıştır [ücretli Gemini üretimi + kullanım yazması]
# 6. isteği önce çalıştırın. verificationAttemptId, generationAttemptId değerinden farklı olmalıdır.
POST {{baseUrl}}/api/v1/articles/review/stages/verify
Content-Type: application/json
Accept: application/json
X-Analysis-Key: {{analysisKey}}

{
  "attemptId": "{{verificationAttemptId}}",
  "settingsFingerprint": "{{quoteVerification.response.body.$.settingsFingerprint}}",
  "requestFingerprint": "{{quoteVerification.response.body.$.requestFingerprint}}",
  "maximumChargeUsd": {{quoteVerification.response.body.$.maximumChargeUsd}},
  "role": "method",
  "source": {
    "language": "en",
    "sourceKind": "pdf",
    "sourceHash": "15675f8dd97b0587f577ccae9a3a080586d9829df718bb59e33f483ce6871fd1",
    "extractionVersion": "manual-pdf-v1",
    "policyVersion": "article-specialist-review-policy-v5",
    "pages": [{ "pageNumber": 1, "text": "The study enrolled 40 participants and reports a mean of 4.2 units." }],
    "totalSourcePages": 1,
    "isPartial": false,
    "scopeReason": null,
    "sourceSpans": [{ "sourceId": "src-1-0-28e3865db3a44714", "pageNumber": 1, "startOffset": 0, "endOffset": 67, "text": "The study enrolled 40 participants and reports a mean of 4.2 units." }]
  },
  "findings": [
    {
      "findingId": "method-1",
      "role": "method",
      "kind": "review_question",
      "basis": "The study enrolled 40 participants.",
      "suggestion": "Report how the sample size was chosen.",
      "sourceIds": ["src-1-0-28e3865db3a44714"]
    }
  ]
}
