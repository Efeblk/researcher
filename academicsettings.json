    "WebOfScienceIdColumn": "WebOfScienceID"
  },
  "ProviderRequestLimits": {
    "Orcid": {
      "MinimumIntervalMilliseconds": 1000,
      "DailyRequestLimit": 0
    },
    "SearchApi": {
      "MinimumIntervalMilliseconds": 1000,
      "DailyRequestLimit": 0
    },
    "OpenAlex": {
      "MinimumIntervalMilliseconds": 1000,
      "DailyRequestLimit": 0
    },
    "WebOfScience": {
      "MinimumIntervalMilliseconds": 1000,
      "DailyRequestLimit": 0
    },
    "Yoksis": {
      "MinimumIntervalMilliseconds": 1000,
      "DailyRequestLimit": 0
    }
  }
