@{
    Layout = "~/Views/Shared/_AcademicLayout.cshtml";
    ViewData["Title"] = "Akademik Performans";
}

<div class="academic-card">
    <h1>Akademisyen Yayınlarını Araştır</h1>
    <p class="academic-help">
        Akademisyenin ORCID numarasını girin. Herkese açık profil ve eser bilgileri
        resmî ORCID API üzerinden alınır.
    </p>

    <form id="ResearcherSearchForm">
        <div class="academic-form-grid">
            <div class="academic-field">
                <label for="Orcid">ORCID</label>
                <input id="Orcid" class="form-control" placeholder="0000-0001-8560-7482"
                       autocomplete="off" data-provider-identifier="Orcid" />
            </div>
        </div>
        <div class="academic-actions">
            <button id="ResearchButton" class="btn btn-primary" type="submit">
                <i class="fa fa-search" aria-hidden="true"></i>
                Araştır
            </button>
            <button id="MyPublicationsButton" class="btn btn-outline-primary" type="button">
                <i class="fa fa-user" aria-hidden="true"></i>
                Yayınlarımı Getir
            </button>
        </div>
        <div id="ResearchStatus" class="academic-status" role="status" aria-live="polite"></div>
    </form>
</div>

<div id="ResearcherSummary" class="academic-card" hidden>
    <h2><span id="MetricsResearcherName">Akademisyen</span> - ORCID Profil Özeti</h2>
    <div class="academic-metrics-grid">
        <div class="academic-metric">
            <span>ORCID kayıtlı eser</span>
            <strong id="MetricsWorksCount">0</strong>
        </div>
        <div class="academic-metric">
            <span>İstihdam kaydı</span>
            <strong id="MetricsEmploymentsCount">0</strong>
        </div>
        <div class="academic-metric">
            <span>Eğitim kaydı</span>
            <strong id="MetricsEducationsCount">0</strong>
        </div>
        <div class="academic-metric">
            <span>Fonlama kaydı</span>
            <strong id="MetricsFundingsCount">0</strong>
        </div>
        <div class="academic-metric">
            <span>Hakemlik grubu</span>
            <strong id="MetricsPeerReviewsCount">0</strong>
        </div>
        <div class="academic-metric">
            <span>Güncel kurum</span>
            <strong id="MetricsOrganization">—</strong>
        </div>
        <div class="academic-metric">
            <span>ORCID kaydı güncellendi</span>
            <strong id="MetricsRecordUpdatedAt">—</strong>
        </div>
    </div>
</div>

<div class="academic-card">
    <div class="academic-publication-selection-header">
        <div>
            <h2>Okulda Gösterilecek Yayınlar</h2>
            <p class="academic-help">
                Okul sisteminde görünmesine izin verdiğiniz yayınları işaretleyip
                seçimlerinizi kaydedin. İşaretlenmeyen yayınlar veritabanında kalır.
            </p>
        </div>
        <div class="academic-publication-selection-actions">
            <span id="SelectionCount">0 yayın seçildi</span>
            <button id="SavePublicationSelections" class="btn btn-primary" type="button" disabled>
                <i class="fa fa-save" aria-hidden="true"></i>
                Seçimleri Kaydet
            </button>
        </div>
    </div>
    <div id="SelectionStatus" class="academic-status" role="status" aria-live="polite"></div>
    <div id="PublicationGrid"></div>
</div>
